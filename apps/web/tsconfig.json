{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "react-renderer": ["../../packages/react-renderer/src/index.ts"],
      "lib/ui": ["./lib/components/ui"],
      "lib/ui/*": ["./lib/components/ui/*"],
      "lib/bizComp": ["./lib/components/biz"],
      "lib/bizComp/*": ["./lib/components/biz/*"],
      "lib/components/biz": ["./lib/components/biz"],
      "lib/components/biz/*": ["./lib/components/biz/*"],
      "lib/hooks": ["./lib/hooks"],
      "lib/hooks/*": ["./lib/hooks/*"],
      "lib/request": ["./lib/request"],
      "lib/request/*": ["./lib/request/*"],
      "lib/serverStore": ["./lib/server-store"],
      "lib/serverStore/*": ["./lib/server-store/*"],
      "lib/services": ["./lib/services"],
      "lib/services/*": ["./lib/services/*"],
      "lib/store": ["./lib/store"],
      "lib/store/*": ["./lib/store/*"],
      "lib/utils": ["./lib/utils"],
      "lib/utils/*": ["./lib/utils/*"],
      "db": ["./db"],
      "db/*": ["./db/*"],
      "actions": ["./app/actions"],
      "actions/*": ["./app/actions/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "../../packages/*/dist"]
}
