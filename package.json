{
  "name": "ai-compoder-workspace",
  "private": true,
  "scripts": {
    "web:dev": "pnpm --filter @ai-compoder/web dev",
    "web:build": "pnpm --filter @ai-compoder/web build",
    "web:start": "pnpm --filter @ai-compoder/web start",
    "web:lint": "pnpm --filter @ai-compoder/web lint",
    "web:test": "pnpm --filter @ai-compoder/web test",
    "web:test:run": "pnpm --filter @ai-compoder/web test:run",
    "web:test:ui": "pnpm --filter @ai-compoder/web test:ui",
    "web:test:coverage": "pnpm --filter @ai-compoder/web test:coverage",
    "web:typecheck": "pnpm --filter @ai-compoder/web typecheck",
    "web:storybook": "pnpm --filter @ai-compoder/web storybook",
    "web:build-storybook": "pnpm --filter @ai-compoder/web build-storybook",
    "ws:build": "pnpm -r --if-present build",
    "ws:lint": "pnpm -r --if-present lint",
    "ws:test": "pnpm -r --if-present test",
    "ws:typecheck": "pnpm -r --if-present typecheck",
    "renderer:build": "pnpm --filter react-renderer build",
    "renderer:dev": "pnpm --filter react-renderer dev"
  }
}
